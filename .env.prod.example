POSTGRES_DB=checkpointd
POSTGRES_USER=checkpointd
POSTGRES_PASSWORD=change-me

# api reaches Postgres over the Docker Compose network, not localhost
DATABASE_URL=jdbc:postgresql://db:5432/checkpointd

# Generate a fresh secret for production — never reuse the local dev one.
# e.g. openssl rand -base64 48
JWT_SECRET=replace-with-a-freshly-generated-production-secret
JWT_EXPIRATION_MINUTES=60

IGDB_CLIENT_ID=replace-with-client-id
IGDB_CLIENT_SECRET=replace-with-client-secret
IGDB_BASE_URL=https://api.igdb.com/v4
TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=checkpointd <noreply@checkpointd.fun>
FRONTEND_URL=https://checkpointd.fun

CORS_ALLOWED_ORIGINS=https://checkpointd.fun
